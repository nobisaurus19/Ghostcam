<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ================= YOYU DESIGN DARK GRID PALETTE ================= -->
    <SolidColorBrush x:Key="BrushCanvasBg" Color="#0B0B0E"/>

    <DrawingBrush x:Key="BrushGraphGrid" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#0B0B0E">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,8,8"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#191920" Thickness="1"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,7.5" EndPoint="8,7.5"/>
                            <LineGeometry StartPoint="7.5,0" EndPoint="7.5,8"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="BrushHeaderBg" Color="#FA0B0B0E"/>
    <SolidColorBrush x:Key="BrushCardBg" Color="#111115"/>
    <SolidColorBrush x:Key="BrushInputBg" Color="#18181E"/>
    <SolidColorBrush x:Key="BrushSecondaryBg" Color="#22222A"/>
    <SolidColorBrush x:Key="BrushBorderPassive" Color="#26262F"/>
    <SolidColorBrush x:Key="BrushBorderActive" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushInkPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushInkSecondary" Color="#C8CCD4"/>
    <SolidColorBrush x:Key="BrushInkMuted" Color="#858890"/>
    <SolidColorBrush x:Key="BrushCtaPrimaryBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushCtaPrimaryFg" Color="#000000"/>
    <SolidColorBrush x:Key="BrushViewportStage" Color="#050507"/>
    <SolidColorBrush x:Key="BrushQrFrameBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushAccentRed" Color="#FF4130"/>
    <SolidColorBrush x:Key="BrushAccentGreen" Color="#00B995"/>
    <SolidColorBrush x:Key="BrushAccentCyan" Color="#99E1FF"/>
    <SolidColorBrush x:Key="BrushAccentYellow" Color="#EEFF5A"/>

    <!-- ================= LEGACY COMPATIBILITY ALIASES ================= -->
    <SolidColorBrush x:Key="BrushBgDeep" Color="#0B0B0E"/>
    <SolidColorBrush x:Key="BrushSurface" Color="#111115"/>
    <SolidColorBrush x:Key="BrushSurfaceHover" Color="#22222A"/>
    <SolidColorBrush x:Key="BrushSurfaceCard" Color="#111115"/>
    <SolidColorBrush x:Key="BrushBorder" Color="#26262F"/>
    <SolidColorBrush x:Key="BrushBorderLight" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushIndigo" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushIndigoHover" Color="#C8CCD4"/>
    <SolidColorBrush x:Key="BrushEmerald" Color="#00B995"/>
    <SolidColorBrush x:Key="BrushEmeraldHover" Color="#00D4AA"/>
    <SolidColorBrush x:Key="BrushDanger" Color="#FF4130"/>
    <SolidColorBrush x:Key="BrushWarning" Color="#EEFF5A"/>
    <SolidColorBrush x:Key="BrushCyan" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#C8CCD4"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="#858890"/>
</ResourceDictionary>
