<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ================= YOYU DESIGN LIGHT GRID PALETTE (DEFAULT) ================= -->
    <SolidColorBrush x:Key="BrushCanvasBg" Color="#FFFFFF"/>

    <DrawingBrush x:Key="BrushGraphGrid" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,8,8"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#E8EBF0" Thickness="1"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,7.5" EndPoint="8,7.5"/>
                            <LineGeometry StartPoint="7.5,0" EndPoint="7.5,8"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="BrushHeaderBg" Color="#FAFFFFFF"/>
    <SolidColorBrush x:Key="BrushCardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushInputBg" Color="#F6F8FB"/>
    <SolidColorBrush x:Key="BrushSecondaryBg" Color="#EDEFF4"/>
    <SolidColorBrush x:Key="BrushBorderPassive" Color="#E2E4EA"/>
    <SolidColorBrush x:Key="BrushBorderActive" Color="#000000"/>
    <SolidColorBrush x:Key="BrushInkPrimary" Color="#000000"/>
    <SolidColorBrush x:Key="BrushInkSecondary" Color="#3A3D45"/>
    <SolidColorBrush x:Key="BrushInkMuted" Color="#858890"/>
    <SolidColorBrush x:Key="BrushCtaPrimaryBg" Color="#000000"/>
    <SolidColorBrush x:Key="BrushCtaPrimaryFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushViewportStage" Color="#111111"/>
    <SolidColorBrush x:Key="BrushQrFrameBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushAccentRed" Color="#FF4130"/>
    <SolidColorBrush x:Key="BrushAccentGreen" Color="#00B995"/>
    <SolidColorBrush x:Key="BrushAccentCyan" Color="#00B4D8"/>
    <SolidColorBrush x:Key="BrushAccentYellow" Color="#EEFF5A"/>

    <!-- ================= LEGACY COMPATIBILITY ALIASES ================= -->
    <SolidColorBrush x:Key="BrushBgDeep" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushSurfaceHover" Color="#EDEFF4"/>
    <SolidColorBrush x:Key="BrushSurfaceCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushBorder" Color="#E2E4EA"/>
    <SolidColorBrush x:Key="BrushBorderLight" Color="#000000"/>
    <SolidColorBrush x:Key="BrushIndigo" Color="#000000"/>
    <SolidColorBrush x:Key="BrushIndigoHover" Color="#3A3D45"/>
    <SolidColorBrush x:Key="BrushEmerald" Color="#00B995"/>
    <SolidColorBrush x:Key="BrushEmeraldHover" Color="#00D4AA"/>
    <SolidColorBrush x:Key="BrushDanger" Color="#FF4130"/>
    <SolidColorBrush x:Key="BrushWarning" Color="#E5A000"/>
    <SolidColorBrush x:Key="BrushCyan" Color="#000000"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#000000"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#3A3D45"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="#858890"/>
</ResourceDictionary>
