<Window x:Class="Ghostcam.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Ghostcam.Studio.ViewModels"
        xmlns:pipeline="clr-namespace:Ghostcam.Media.Pipeline;assembly=Ghostcam.Media"
        mc:Ignorable="d"
        Title="Ghostcam Studio"
        Icon="pack://application:,,,/Ghostcam.Studio;component/ghostcam.ico"
        Width="1440" Height="880"
        MinWidth="1220" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushGraphGrid}"
        Foreground="{DynamicResource BrushInkPrimary}"
        TextElement.FontFamily="{StaticResource FontYoyuSans}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= ROW 0: FIXED MINIMAL YOYU TOP HEADER ================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource BrushHeaderBg}"
                BorderBrush="{DynamicResource BrushBorderPassive}"
                BorderThickness="0,0,0,1"
                CornerRadius="0"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: 1-Bit Pixel Ghost Monogram + Wordmark -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 1-Bit Pixel Ghost Sprite (26x26, 2px pixel blocks, YOYU 8-bit stepped loop) -->
                    <Canvas Width="26" Height="26" SnapsToDevicePixels="True" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Canvas.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhostBob"
                                                                       Storyboard.TargetProperty="Y"
                                                                       RepeatBehavior="Forever">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="-2"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.8" Value="0"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="1"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhostFeetTransform"
                                                                       Storyboard.TargetProperty="X"
                                                                       RepeatBehavior="Forever">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="1"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.8" Value="0"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="-1"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhostBlinkBar"
                                                                       Storyboard.TargetProperty="Opacity"
                                                                       RepeatBehavior="Forever">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.8" Value="1"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.96" Value="0"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:3.2" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SparkleGreen"
                                                                       Storyboard.TargetProperty="Opacity"
                                                                       RepeatBehavior="Forever">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="1"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.8" Value="0"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SparkleCyan"
                                                                       Storyboard.TargetProperty="Opacity"
                                                                       RepeatBehavior="Forever">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="1"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="0"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Canvas.Triggers>

                        <Canvas x:Name="GhostBodyCanvas" Width="26" Height="26">
                            <Canvas.RenderTransform>
                                <TranslateTransform x:Name="GhostBob" Y="0"/>
                            </Canvas.RenderTransform>
                            <!-- Top dome -->
                            <Rectangle Canvas.Left="8" Canvas.Top="2" Width="10" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                            <Rectangle Canvas.Left="6" Canvas.Top="4" Width="14" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                            <Rectangle Canvas.Left="4" Canvas.Top="6" Width="18" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                            <!-- Eyes row (symmetric 2x4 pixel eye cutouts) -->
                            <Rectangle Canvas.Left="4" Canvas.Top="8" Width="4" Height="4" Fill="{DynamicResource BrushInkPrimary}"/>
                            <Rectangle Canvas.Left="10" Canvas.Top="8" Width="6" Height="4" Fill="{DynamicResource BrushInkPrimary}"/>
                            <Rectangle Canvas.Left="18" Canvas.Top="8" Width="4" Height="4" Fill="{DynamicResource BrushInkPrimary}"/>
                            <Rectangle x:Name="GhostBlinkBar" Canvas.Left="6" Canvas.Top="8" Width="14" Height="4" Fill="{DynamicResource BrushInkPrimary}" Opacity="0"/>
                            <!-- Body -->
                            <Rectangle Canvas.Left="4" Canvas.Top="12" Width="18" Height="8" Fill="{DynamicResource BrushInkPrimary}"/>
                            <!-- Wavy bottom hem -->
                            <Rectangle Canvas.Left="4" Canvas.Top="20" Width="4" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                            <Rectangle Canvas.Left="10" Canvas.Top="20" Width="6" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                            <Rectangle Canvas.Left="18" Canvas.Top="20" Width="4" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                            <Canvas x:Name="GhostFeetCanvas" Width="26" Height="26">
                                <Canvas.RenderTransform>
                                    <TranslateTransform x:Name="GhostFeetTransform" X="0"/>
                                </Canvas.RenderTransform>
                                <Rectangle Canvas.Left="4" Canvas.Top="22" Width="2" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                <Rectangle Canvas.Left="12" Canvas.Top="22" Width="2" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                <Rectangle Canvas.Left="20" Canvas.Top="22" Width="2" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                            </Canvas>
                        </Canvas>

                        <Rectangle x:Name="SparkleGreen" Canvas.Left="22" Canvas.Top="2" Width="2" Height="2" Fill="{DynamicResource BrushAccentGreen}" Opacity="0"/>
                        <Rectangle x:Name="SparkleCyan" Canvas.Left="2" Canvas.Top="4" Width="2" Height="2" Fill="{DynamicResource BrushAccentCyan}" Opacity="0"/>
                    </Canvas>

                    <TextBlock Text="GHOSTCAM"
                               FontFamily="{StaticResource FontYoyuPixel}"
                               FontSize="15"
                               FontWeight="Normal"
                               Foreground="{DynamicResource BrushInkPrimary}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="STUDIO"
                               FontFamily="{StaticResource FontYoyuPixel}"
                               FontSize="11"
                               FontWeight="Normal"
                               Foreground="{DynamicResource BrushInkMuted}"
                               Margin="6,2,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Architectural Status Strip -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Phone Status -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Fill" Value="#858890"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPhoneConnected}" Value="True">
                                            <Setter Property="Fill" Value="#00B995"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <TextBlock Text="{Binding ConnectionStatusBadge}"
                                   FontFamily="{StaticResource FontYoyuMono}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushInkPrimary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" / "
                                   FontFamily="{StaticResource FontYoyuMono}"
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushInkMuted}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConnectedPhoneName}"
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushInkMuted}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Rectangle Width="1" Height="18" Fill="{DynamicResource BrushBorderPassive}" Margin="16,0" VerticalAlignment="Center"/>

                    <!-- Virtual Camera Status -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Fill" Value="#858890"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVirtualCamActive}" Value="True">
                                            <Setter Property="Fill" Value="#00B995"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <TextBlock Text="{Binding VirtualCamStatusText}"
                                   FontFamily="{StaticResource FontYoyuMono}"
                                   FontSize="11"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushInkSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVirtualCamActive}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushAccentGreen}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Profiles | Audio VU + MIC | THEME | HUD | TRAY -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Resources>
                        <Style x:Key="HeaderProfileSlotBaseStyle" TargetType="Button" BasedOn="{StaticResource StudioButtonStyle}">
                            <Setter Property="Padding" Value="7,4"/>
                            <Setter Property="FontFamily" Value="{StaticResource FontYoyuMono}"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="0"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrushBorderActive}"/>
                                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Opacity" Value="0.72"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>

                    <Rectangle Width="1" Height="28" Fill="{DynamicResource BrushBorderPassive}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                    <!-- Profile Slot Cluster (P1 / P2 / P3 + SAVE) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="P1"
                                Command="{Binding LoadProfileCommand}"
                                CommandParameter="P1"
                                Margin="0,0,3,0"
                                ToolTip="Load Profile Slot P1">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HeaderProfileSlotBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProfile1}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushCtaPrimaryBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BrushCtaPrimaryFg}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderActive}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="P2"
                                Command="{Binding LoadProfileCommand}"
                                CommandParameter="P2"
                                Margin="0,0,3,0"
                                ToolTip="Load Profile Slot P2">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HeaderProfileSlotBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProfile2}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushCtaPrimaryBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BrushCtaPrimaryFg}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderActive}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="P3"
                                Command="{Binding LoadProfileCommand}"
                                CommandParameter="P3"
                                Margin="0,0,3,0"
                                ToolTip="Load Profile Slot P3">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HeaderProfileSlotBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProfile3}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushCtaPrimaryBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BrushCtaPrimaryFg}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderActive}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="SAVE"
                                Style="{StaticResource StudioButtonStyle}"
                                Command="{Binding SaveActiveProfileCommand}"
                                Padding="7,4"
                                FontFamily="{StaticResource FontYoyuMono}"
                                FontSize="10"
                                FontWeight="Bold"
                                ToolTip="Save current settings to active profile slot"/>
                    </StackPanel>

                    <Rectangle Width="1" Height="22" Fill="{DynamicResource BrushBorderPassive}" Margin="8,0" VerticalAlignment="Center"/>

                    <!-- 1-Bit Pixel VU Meter + MIC Monitor Toggle -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Height="20" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Live Mobile Audio Level">
                            <Rectangle Width="3" Height="6" VerticalAlignment="Bottom" Margin="0,0,2,0" Fill="{DynamicResource BrushAccentGreen}">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Opacity" Value="0.18"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VuBar1}" Value="True">
                                                <Setter Property="Opacity" Value="1.0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <Rectangle Width="3" Height="9" VerticalAlignment="Bottom" Margin="0,0,2,0" Fill="{DynamicResource BrushAccentGreen}">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Opacity" Value="0.18"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VuBar2}" Value="True">
                                                <Setter Property="Opacity" Value="1.0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <Rectangle Width="3" Height="12" VerticalAlignment="Bottom" Margin="0,0,2,0" Fill="{DynamicResource BrushAccentGreen}">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Opacity" Value="0.18"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VuBar3}" Value="True">
                                                <Setter Property="Opacity" Value="1.0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <Rectangle Width="3" Height="15" VerticalAlignment="Bottom" Margin="0,0,2,0" Fill="#EEFF5A">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Opacity" Value="0.18"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VuBar4}" Value="True">
                                                <Setter Property="Opacity" Value="1.0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <Rectangle Width="3" Height="18" VerticalAlignment="Bottom" Fill="#FF4130">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Opacity" Value="0.18"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VuBar5}" Value="True">
                                                <Setter Property="Opacity" Value="1.0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                        </StackPanel>

                        <ToggleButton IsChecked="{Binding IsMicMonitorEnabled, Mode=TwoWay}"
                                      Cursor="Hand"
                                      ToolTip="Monitor Mobile Audio on PC Speakers">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="micBorder"
                                            Background="{DynamicResource BrushCardBg}"
                                            BorderBrush="{DynamicResource BrushBorderPassive}"
                                            BorderThickness="1"
                                            CornerRadius="0"
                                            Padding="7,4"
                                            SnapsToDevicePixels="True">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Rectangle x:Name="micLed" Width="5" Height="5" Fill="{DynamicResource BrushInkMuted}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="micText"
                                                       Text="MIC"
                                                       FontFamily="{StaticResource FontYoyuMono}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource BrushInkSecondary}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="micBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderActive}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="micBorder" Property="BorderBrush" Value="{DynamicResource BrushAccentGreen}"/>
                                            <Setter TargetName="micBorder" Property="Background" Value="{DynamicResource BrushInputBg}"/>
                                            <Setter TargetName="micLed" Property="Fill" Value="{DynamicResource BrushAccentGreen}"/>
                                            <Setter TargetName="micText" Property="Foreground" Value="{DynamicResource BrushAccentGreen}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </StackPanel>

                    <Rectangle Width="1" Height="22" Fill="{DynamicResource BrushBorderPassive}" Margin="8,0" VerticalAlignment="Center"/>

                    <!-- THEME Dual-State Pixel Toggle -->
                    <Button Command="{Binding ToggleThemeCommand}" Cursor="Hand" ToolTip="Toggle Light / Dark Studio Theme">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="toggleBg" Background="Transparent" CornerRadius="0" Padding="8,4">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                                            <!-- Pixel Sun (Light Mode) -->
                                            <Canvas Width="14" Height="14" SnapsToDevicePixels="True">
                                                <Canvas.Style>
                                                    <Style TargetType="Canvas">
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                                <Setter Property="Opacity" Value="0.22"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Canvas.Style>
                                                <Rectangle Canvas.Left="4" Canvas.Top="4" Width="6" Height="6" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="6" Canvas.Top="0" Width="2" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="6" Canvas.Top="12" Width="2" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="0" Canvas.Top="6" Width="2" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="12" Canvas.Top="6" Width="2" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="2" Canvas.Top="2" Width="2" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="10" Canvas.Top="2" Width="2" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="2" Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="10" Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                            </Canvas>

                                            <Rectangle Width="6" Height="1" Fill="Transparent"/>

                                            <!-- Pixel Moon (Dark Mode) -->
                                            <Canvas Width="14" Height="14" SnapsToDevicePixels="True">
                                                <Canvas.Style>
                                                    <Style TargetType="Canvas">
                                                        <Setter Property="Opacity" Value="0.22"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Canvas.Style>
                                                <Rectangle Canvas.Left="4" Canvas.Top="2" Width="4" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="2" Canvas.Top="4" Width="4" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="2" Canvas.Top="6" Width="2" Height="4" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="4" Canvas.Top="8" Width="2" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="4" Canvas.Top="10" Width="6" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="10" Canvas.Top="8" Width="2" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                            </Canvas>
                                        </StackPanel>
                                        <TextBlock Text="THEME"
                                                   FontFamily="{StaticResource FontYoyuPixel}"
                                                   FontSize="8"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource BrushInkMuted}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="toggleBg" Property="Background" Value="{DynamicResource BrushInputBg}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Rectangle Width="1" Height="22" Fill="{DynamicResource BrushBorderPassive}" Margin="4,0" VerticalAlignment="Center"/>

                    <!-- HUD Dual-State Pixel Toggle -->
                    <ToggleButton IsChecked="{Binding FilterSettings.ShowHudOverlay}" Cursor="Hand" ToolTip="Toggle Grid / HUD Overlay">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="hudBg" Background="Transparent" CornerRadius="0" Padding="8,4">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                                            <!-- Empty Pixel Frame (HUD OFF) -->
                                            <Canvas x:Name="hudOffIcon" Width="14" Height="14" SnapsToDevicePixels="True" Opacity="1.0">
                                                <Rectangle Canvas.Left="0" Canvas.Top="0" Width="14" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="0" Canvas.Top="12" Width="14" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="0" Canvas.Top="2" Width="2" Height="10" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="12" Canvas.Top="2" Width="2" Height="10" Fill="{DynamicResource BrushInkPrimary}"/>
                                            </Canvas>

                                            <Rectangle Width="6" Height="1" Fill="Transparent"/>

                                            <!-- Pixel Crosshair Grid (HUD ON) -->
                                            <Canvas x:Name="hudOnIcon" Width="14" Height="14" SnapsToDevicePixels="True" Opacity="0.22">
                                                <Rectangle Canvas.Left="0" Canvas.Top="0" Width="4" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="0" Canvas.Top="2" Width="2" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="10" Canvas.Top="0" Width="4" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="12" Canvas.Top="2" Width="2" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="0" Canvas.Top="12" Width="4" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="0" Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="10" Canvas.Top="12" Width="4" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="12" Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="6" Canvas.Top="4" Width="2" Height="6" Fill="{DynamicResource BrushInkPrimary}"/>
                                                <Rectangle Canvas.Left="4" Canvas.Top="6" Width="6" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                            </Canvas>
                                        </StackPanel>
                                        <TextBlock Text="HUD"
                                                   FontFamily="{StaticResource FontYoyuPixel}"
                                                   FontSize="8"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource BrushInkMuted}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="hudOffIcon" Property="Opacity" Value="0.22"/>
                                        <Setter TargetName="hudOnIcon" Property="Opacity" Value="1.0"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="hudBg" Property="Background" Value="{DynamicResource BrushInputBg}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Rectangle Width="1" Height="22" Fill="{DynamicResource BrushBorderPassive}" Margin="4,0" VerticalAlignment="Center"/>

                    <!-- TRAY Pixel Button -->
                    <Button Command="{Binding MinimizeToTrayCommand}" Cursor="Hand" ToolTip="Minimize to System Tray (Keep Virtual Camera Running)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="trayBg" Background="Transparent" CornerRadius="0" Padding="8,4">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="14" Height="14" SnapsToDevicePixels="True" HorizontalAlignment="Center" Margin="0,0,0,3">
                                            <!-- Downward Arrow -->
                                            <Rectangle Canvas.Left="6" Canvas.Top="1" Width="2" Height="6" Fill="{DynamicResource BrushInkPrimary}"/>
                                            <Rectangle Canvas.Left="4" Canvas.Top="5" Width="6" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                            <Rectangle Canvas.Left="6" Canvas.Top="7" Width="2" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                            <!-- Tray Base -->
                                            <Rectangle Canvas.Left="1" Canvas.Top="9" Width="2" Height="4" Fill="{DynamicResource BrushInkPrimary}"/>
                                            <Rectangle Canvas.Left="11" Canvas.Top="9" Width="2" Height="4" Fill="{DynamicResource BrushInkPrimary}"/>
                                            <Rectangle Canvas.Left="1" Canvas.Top="11" Width="12" Height="2" Fill="{DynamicResource BrushInkPrimary}"/>
                                        </Canvas>
                                        <TextBlock Text="TRAY"
                                                   FontFamily="{StaticResource FontYoyuPixel}"
                                                   FontSize="8"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource BrushInkMuted}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="trayBg" Property="Background" Value="{DynamicResource BrushInputBg}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= ROW 1: THREE-COLUMN ARCHITECTURAL WORKSPACE ================= -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="316"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="324"/>
            </Grid.ColumnDefinitions>

            <!-- ================= COL 0: LEFT ARCHITECTURAL PANEL ================= -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- CARD 1: 01 / INPUT SOURCE -->
                    <Border Background="{DynamicResource BrushCardBg}"
                            BorderBrush="{DynamicResource BrushBorderPassive}"
                            BorderThickness="1"
                            CornerRadius="0"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="01 / INPUT SOURCE"
                                       FontFamily="{StaticResource FontYoyuPixel}"
                                       FontSize="10.5"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource BrushInkPrimary}"/>
                            <TextBlock Text="เลือกแหล่งสัญญาณภาพกล้อง"
                                       FontSize="10"
                                       Foreground="{DynamicResource BrushInkMuted}"
                                       Margin="0,2,0,10"/>

                            <!-- Two Side-by-Side YOYU Tab-Style RadioButtons -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <RadioButton Grid.Column="0"
                                             GroupName="SourceModes"
                                             IsChecked="{Binding IsWifiQrMode, Mode=OneWay}"
                                             Command="{Binding SetSourceModeCommand}"
                                             CommandParameter="SafariWebCam"
                                             Cursor="Hand"
                                             Margin="0,0,4,0">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="tabBorder"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource BrushBorderPassive}"
                                                    BorderThickness="0,0,0,1"
                                                    CornerRadius="0"
                                                    Padding="8,8">
                                                <StackPanel>
                                                    <TextBlock x:Name="tabTitle"
                                                               Text="MOBILE WEBCAM"
                                                               FontFamily="{StaticResource FontYoyuMono}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource BrushInkSecondary}"/>
                                                    <TextBlock Text="Safari / QR"
                                                               FontSize="9.5"
                                                               Foreground="{DynamicResource BrushInkMuted}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource BrushInputBg}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource BrushInputBg}"/>
                                                    <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderActive}"/>
                                                    <Setter TargetName="tabBorder" Property="BorderThickness" Value="0,0,0,2"/>
                                                    <Setter TargetName="tabTitle" Property="Foreground" Value="{DynamicResource BrushInkPrimary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>

                                <RadioButton Grid.Column="1"
                                             GroupName="SourceModes"
                                             IsChecked="{Binding IsSyntheticMode, Mode=OneWay}"
                                             Command="{Binding SetSourceModeCommand}"
                                             CommandParameter="SyntheticTestCamera"
                                             Cursor="Hand"
                                             Margin="4,0,0,0">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="tabBorder"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource BrushBorderPassive}"
                                                    BorderThickness="0,0,0,1"
                                                    CornerRadius="0"
                                                    Padding="8,8">
                                                <StackPanel>
                                                    <TextBlock x:Name="tabTitle"
                                                               Text="TEST CAMERA"
                                                               FontFamily="{StaticResource FontYoyuMono}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource BrushInkSecondary}"/>
                                                    <TextBlock Text="60 FPS Pattern"
                                                               FontSize="9.5"
                                                               Foreground="{DynamicResource BrushInkMuted}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource BrushInputBg}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource BrushInputBg}"/>
                                                    <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderActive}"/>
                                                    <Setter TargetName="tabBorder" Property="BorderThickness" Value="0,0,0,2"/>
                                                    <Setter TargetName="tabTitle" Property="Foreground" Value="{DynamicResource BrushInkPrimary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                            </Grid>

                            <!-- QR Pairing Well -->
                            <Border Visibility="{Binding IsWifiQrMode, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource BrushInputBg}"
                                    BorderBrush="{DynamicResource BrushBorderPassive}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Padding="12"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding QrBoxHeader}"
                                               FontFamily="{StaticResource FontYoyuMono}"
                                               FontWeight="Bold"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource BrushAccentCyan}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,10"/>

                                    <Border Background="{DynamicResource BrushQrFrameBg}"
                                            BorderBrush="{DynamicResource BrushBorderActive}"
                                            BorderThickness="1"
                                            CornerRadius="0"
                                            Padding="6"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,10">
                                        <Image Source="{Binding QrCodeImage}"
                                               Width="164"
                                               Height="164"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>

                                    <TextBlock Text="{Binding QrSubtitleText}"
                                               FontSize="10"
                                               Foreground="{DynamicResource BrushInkMuted}"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="0,0,0,8"/>

                                    <Border Background="{DynamicResource BrushCardBg}"
                                            BorderBrush="{DynamicResource BrushBorderPassive}"
                                            BorderThickness="1"
                                            CornerRadius="0"
                                            Padding="8,5"
                                            Margin="0,0,0,8">
                                        <TextBlock Text="{Binding QrUrlText}"
                                                   FontSize="11"
                                                   FontFamily="{StaticResource FontYoyuMono}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushInkPrimary}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <Button Content="{Binding QrToggleText}"
                                            Style="{StaticResource StudioButtonStyle}"
                                            Command="{Binding RefreshQrCommand}"
                                            FontFamily="{StaticResource FontYoyuMono}"
                                            FontSize="10.5"
                                            Padding="12,6"
                                            Margin="0,0,0,8"/>

                                    <TextBlock Text="💡 หาก Safari ขึ้นเตือนความปลอดภัย: แตะ 'Show Details' → 'visit this website' เพียงครั้งเดียว iOS จะจำสิทธิ์ถาวร"
                                               FontSize="9"
                                               Foreground="{DynamicResource BrushInkMuted}"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- USB Tunnel Status Box -->
                            <Border Visibility="{Binding IsUsbMode, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource BrushInputBg}"
                                    BorderBrush="{DynamicResource BrushBorderPassive}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Padding="10"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="USB TUNNEL STATUS"
                                               FontFamily="{StaticResource FontYoyuMono}"
                                               FontWeight="Bold"
                                               FontSize="10"
                                               Foreground="{DynamicResource BrushInkMuted}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding UsbStatusText}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource BrushInkSecondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <Button Content="SCAN / REFRESH USB"
                                            Style="{StaticResource StudioButtonStyle}"
                                            Command="{Binding RefreshUsbCommand}"
                                            FontFamily="{StaticResource FontYoyuMono}"
                                            FontSize="10"
                                            Padding="10,5"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: 02 / CAMERA SENSOR -->
                    <Border Background="{DynamicResource BrushCardBg}"
                            BorderBrush="{DynamicResource BrushBorderPassive}"
                            BorderThickness="1"
                            CornerRadius="0"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="02 / CAMERA SENSOR"
                                       FontFamily="{StaticResource FontYoyuPixel}"
                                       FontSize="10.5"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource BrushInkPrimary}"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Camera Lens"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource BrushInkSecondary}"
                                       Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding AvailableLenses}"
                                      SelectedItem="{Binding SelectedLens}"
                                      Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Resolution (All Unlocked!)"
                                               FontSize="10"
                                               Foreground="{DynamicResource BrushInkSecondary}"
                                               Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding AvailableResolutions}"
                                              SelectedItem="{Binding SelectedResolution}"
                                              FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="Framerate"
                                               FontSize="10"
                                               Foreground="{DynamicResource BrushInkSecondary}"
                                               Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding AvailableFps}"
                                              SelectedItem="{Binding SelectedFps}"
                                              FontSize="11"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="WAKE"
                                        Style="{StaticResource StudioButtonStyle}"
                                        Command="{Binding WakeSensorCommand}"
                                        Margin="0,0,3,0"
                                        FontFamily="{StaticResource FontYoyuMono}"
                                        FontSize="10.5"
                                        Padding="6,6"/>

                                <Button Grid.Column="1"
                                        Content="SLEEP"
                                        Style="{StaticResource StudioButtonStyle}"
                                        Command="{Binding SleepSensorCommand}"
                                        Margin="3,0,3,0"
                                        FontFamily="{StaticResource FontYoyuMono}"
                                        FontSize="10.5"
                                        Padding="6,6"/>

                                <Button Grid.Column="2"
                                        Command="{Binding ToggleTorchCommand}"
                                        Margin="3,0,0,0"
                                        FontFamily="{StaticResource FontYoyuMono}"
                                        FontSize="10.5"
                                        Padding="6,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource StudioButtonStyle}">
                                            <Setter Property="Content" Value="TORCH"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HardwareTorch}" Value="True">
                                                    <Setter Property="Content" Value="TORCH ON"/>
                                                    <Setter Property="Background" Value="{DynamicResource BrushAccentYellow}"/>
                                                    <Setter Property="Foreground" Value="#000000"/>
                                                    <Setter Property="BorderBrush" Value="#000000"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3: 03 / HARDWARE EXPOSURE -->
                    <Border Background="{DynamicResource BrushCardBg}"
                            BorderBrush="{DynamicResource BrushBorderPassive}"
                            BorderThickness="1"
                            CornerRadius="0"
                            Padding="14"
                            Margin="0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="03 / HARDWARE EXPOSURE"
                                           FontFamily="{StaticResource FontYoyuPixel}"
                                           FontWeight="Normal"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource BrushInkPrimary}"
                                           VerticalAlignment="Center"/>
                                <Button Content="RESET"
                                        Style="{StaticResource StudioButtonStyle}"
                                        Command="{Binding ResetExposureCommand}"
                                        FontFamily="{StaticResource FontYoyuMono}"
                                        FontSize="9.5"
                                        Padding="8,3"
                                        HorizontalAlignment="Right"/>
                            </DockPanel>

                            <!-- ISO -->
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="Sensor ISO" FontSize="11" Foreground="{DynamicResource BrushInkSecondary}"/>
                                <TextBlock Text="{Binding HardwareIso, StringFormat='{}ISO {0:0}'}"
                                           FontFamily="{StaticResource FontYoyuMono}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushAccentCyan}"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider Minimum="50" Maximum="3200" Value="{Binding HardwareIso, Mode=TwoWay}" IsMoveToPointEnabled="True" SmallChange="50" LargeChange="200"/>

                            <!-- Shutter Speed -->
                            <DockPanel Margin="0,4,0,2">
                                <TextBlock Text="Shutter Speed" FontSize="11" Foreground="{DynamicResource BrushInkSecondary}"/>
                                <TextBlock Text="{Binding HardwareShutter, StringFormat='{}1/{0:0}s'}"
                                           FontFamily="{StaticResource FontYoyuMono}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushAccentCyan}"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider Minimum="30" Maximum="1000" Value="{Binding HardwareShutter, Mode=TwoWay}" IsMoveToPointEnabled="True" SmallChange="10" LargeChange="50"/>

                            <!-- White Balance -->
                            <DockPanel Margin="0,4,0,2">
                                <TextBlock Text="White Balance" FontSize="11" Foreground="{DynamicResource BrushInkSecondary}"/>
                                <TextBlock Text="{Binding HardwareWbKelvin, StringFormat='{}{0:0}K'}"
                                           FontFamily="{StaticResource FontYoyuMono}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushAccentCyan}"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider Minimum="2500" Maximum="7500" Value="{Binding HardwareWbKelvin, Mode=TwoWay}" IsMoveToPointEnabled="True" SmallChange="100" LargeChange="500"/>

                            <!-- Manual Focus -->
                            <DockPanel Margin="0,4,0,2">
                                <TextBlock Text="Manual Focus" FontSize="11" Foreground="{DynamicResource BrushInkSecondary}"/>
                                <TextBlock Text="{Binding HardwareFocus, StringFormat='{}{0:P0}'}"
                                           FontFamily="{StaticResource FontYoyuMono}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushAccentCyan}"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding HardwareFocus, Mode=TwoWay}" IsMoveToPointEnabled="True" SmallChange="0.05" LargeChange="0.1" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ================= COL 1: CENTER LIVE CINEMA STAGE ================= -->
            <Grid Grid.Column="1" Margin="16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ROW 0: TOP ARCHITECTURAL TELEMETRY BAR -->
                <Border Grid.Row="0"
                        Background="{DynamicResource BrushCardBg}"
                        BorderBrush="{DynamicResource BrushBorderPassive}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Padding="12,8"
                        Margin="0,0,0,12">
                    <DockPanel>
                        <!-- Snapshot Notification Badge -->
                        <Border DockPanel.Dock="Right"
                                Background="{DynamicResource BrushAccentGreen}"
                                CornerRadius="0"
                                Padding="8,2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowSnapshotNotification, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SnapshotNotificationText}"
                                       FontFamily="{StaticResource FontYoyuMono}"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Foreground="#000000"/>
                        </Border>

                        <!-- Telemetry Cells -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TelemetryResolution}"
                                       FontFamily="{StaticResource FontYoyuMono}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushInkPrimary}"
                                       VerticalAlignment="Center"/>

                            <Rectangle Width="1" Height="14" Fill="{DynamicResource BrushBorderPassive}" Margin="10,0" VerticalAlignment="Center"/>

                            <TextBlock Text="{Binding TelemetryFps}"
                                       FontFamily="{StaticResource FontYoyuMono}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushAccentGreen}"
                                       VerticalAlignment="Center"/>

                            <Rectangle Width="1" Height="14" Fill="{DynamicResource BrushBorderPassive}" Margin="10,0" VerticalAlignment="Center"/>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TelemetryBitrate}"
                                           FontFamily="{StaticResource FontYoyuMono}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushInkPrimary}"/>
                                <TextBlock Text=" / "
                                           FontFamily="{StaticResource FontYoyuMono}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBlock Text="{Binding TelemetryNals}"
                                           FontFamily="{StaticResource FontYoyuMono}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource BrushInkMuted}"/>
                            </StackPanel>

                            <Rectangle Width="1" Height="14" Fill="{DynamicResource BrushBorderPassive}" Margin="10,0" VerticalAlignment="Center"/>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TelemetryBattery}"
                                           FontFamily="{StaticResource FontYoyuMono}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource BrushInkPrimary}"/>
                                <TextBlock Text=" / "
                                           FontFamily="{StaticResource FontYoyuMono}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource BrushInkMuted}"/>
                                <TextBlock Text="{Binding TelemetryThermal}"
                                           FontFamily="{StaticResource FontYoyuMono}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource BrushInkMuted}"/>
                            </StackPanel>

                            <Rectangle Width="1" Height="14" Fill="{DynamicResource BrushBorderPassive}" Margin="10,0" VerticalAlignment="Center"/>

                            <TextBlock Text="{Binding TelemetryClients}"
                                       FontFamily="{StaticResource FontYoyuMono}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource BrushInkSecondary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ROW 1: HIGH-CONTRAST STARK BLACK CINEMA STAGE -->
                <Border Grid.Row="1"
                        Background="{DynamicResource BrushViewportStage}"
                        BorderBrush="{DynamicResource BrushBorderActive}"
                        BorderThickness="1"
                        CornerRadius="0"
                        ClipToBounds="True">
                    <Grid>
                        <Image Source="{Binding ViewportBitmap}"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding IsWaitingForSignal, Converter={StaticResource InverseBoolToVis}}"/>

                        <!-- Waiting For Signal Overlay (Animated 1-Bit Pixel Ghost) -->
                        <StackPanel Visibility="{Binding IsWaitingForSignal, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <!-- Large 88x88 1-Bit Pixel Ghost (6px pixel grid centered on dark stage) -->
                            <Canvas Width="88" Height="88" SnapsToDevicePixels="True" HorizontalAlignment="Center" Margin="0,0,0,18">
                                <Canvas.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhostWaitBob"
                                                                               Storyboard.TargetProperty="Y"
                                                                               RepeatBehavior="Forever">
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="-6"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.8" Value="0"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="3"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="0"/>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhostWaitFeetTransform"
                                                                               Storyboard.TargetProperty="X"
                                                                               RepeatBehavior="Forever">
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="4"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.8" Value="0"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="-4"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="0"/>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhostWaitBlinkBar"
                                                                               Storyboard.TargetProperty="Opacity"
                                                                               RepeatBehavior="Forever">
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:2.8" Value="1"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:2.96" Value="0"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:3.2" Value="0"/>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WaitSparkGreen"
                                                                               Storyboard.TargetProperty="Opacity"
                                                                               RepeatBehavior="Forever">
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="1"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.8" Value="0"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="0"/>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WaitSparkCyan"
                                                                               Storyboard.TargetProperty="Opacity"
                                                                               RepeatBehavior="Forever">
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="1"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="0"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="0"/>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WaitSparkYellow"
                                                                               Storyboard.TargetProperty="Opacity"
                                                                               RepeatBehavior="Forever">
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.8" Value="1"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="0"/>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WaitCursor"
                                                                               Storyboard.TargetProperty="Opacity"
                                                                               RepeatBehavior="Forever">
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:1.0" Value="1"/>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Canvas.Triggers>

                                <Canvas Width="88" Height="88">
                                    <Canvas.RenderTransform>
                                        <TranslateTransform x:Name="GhostWaitBob" Y="0"/>
                                    </Canvas.RenderTransform>
                                    <!-- 12x6px grid centered at offset (8, 8) -->
                                    <Rectangle Canvas.Left="32" Canvas.Top="14" Width="24" Height="6" Fill="#FFFFFF"/>
                                    <Rectangle Canvas.Left="26" Canvas.Top="20" Width="36" Height="6" Fill="#FFFFFF"/>
                                    <Rectangle Canvas.Left="20" Canvas.Top="26" Width="48" Height="6" Fill="#FFFFFF"/>
                                    <!-- Eyes row -->
                                    <Rectangle Canvas.Left="20" Canvas.Top="32" Width="12" Height="12" Fill="#FFFFFF"/>
                                    <Rectangle Canvas.Left="38" Canvas.Top="32" Width="12" Height="12" Fill="#FFFFFF"/>
                                    <Rectangle Canvas.Left="56" Canvas.Top="32" Width="12" Height="12" Fill="#FFFFFF"/>
                                    <Rectangle x:Name="GhostWaitBlinkBar" Canvas.Left="26" Canvas.Top="32" Width="36" Height="12" Fill="#FFFFFF" Opacity="0"/>
                                    <!-- Body -->
                                    <Rectangle Canvas.Left="20" Canvas.Top="44" Width="48" Height="18" Fill="#FFFFFF"/>
                                    <!-- Wavy bottom upper -->
                                    <Rectangle Canvas.Left="20" Canvas.Top="62" Width="12" Height="6" Fill="#FFFFFF"/>
                                    <Rectangle Canvas.Left="38" Canvas.Top="62" Width="12" Height="6" Fill="#FFFFFF"/>
                                    <Rectangle Canvas.Left="56" Canvas.Top="62" Width="12" Height="6" Fill="#FFFFFF"/>
                                    <!-- Animated wavy bottom tips -->
                                    <Canvas Width="88" Height="88">
                                        <Canvas.RenderTransform>
                                            <TranslateTransform x:Name="GhostWaitFeetTransform" X="0"/>
                                        </Canvas.RenderTransform>
                                        <Rectangle Canvas.Left="20" Canvas.Top="68" Width="6" Height="6" Fill="#FFFFFF"/>
                                        <Rectangle Canvas.Left="41" Canvas.Top="68" Width="6" Height="6" Fill="#FFFFFF"/>
                                        <Rectangle Canvas.Left="62" Canvas.Top="68" Width="6" Height="6" Fill="#FFFFFF"/>
                                    </Canvas>
                                </Canvas>

                                <!-- YOYU Pixel Sparkles -->
                                <Rectangle x:Name="WaitSparkGreen" Canvas.Left="72" Canvas.Top="10" Width="6" Height="6" Fill="{DynamicResource BrushAccentGreen}" Opacity="0"/>
                                <Rectangle x:Name="WaitSparkCyan" Canvas.Left="8" Canvas.Top="18" Width="6" Height="6" Fill="#63DDFF" Opacity="0"/>
                                <Rectangle x:Name="WaitSparkYellow" Canvas.Left="76" Canvas.Top="54" Width="6" Height="6" Fill="{DynamicResource BrushAccentYellow}" Opacity="0"/>
                            </Canvas>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="WAITING FOR SIGNAL"
                                           FontFamily="{StaticResource FontYoyuPixel}"
                                           FontSize="20"
                                           FontWeight="Normal"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"/>
                                <Rectangle x:Name="WaitCursor" Width="10" Height="18" Fill="#00B995" Margin="8,2,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="[ SCAN QR CODE WITH IPHONE / ANDROID TO START CAMERA STREAM ]"
                                       FontFamily="{StaticResource FontYoyuMono}"
                                       FontSize="10.5"
                                       Foreground="#858890"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0"/>
                        </StackPanel>

                        <!-- 4-Corner 12x12 Architectural Viewfinder L-Brackets -->
                        <Path Data="M 0 12 L 0 0 L 12 0"
                              Stroke="#FFFFFF"
                              StrokeThickness="1"
                              Opacity="0.35"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Margin="12"
                              IsHitTestVisible="False"/>
                        <Path Data="M 0 0 L 12 0 L 12 12"
                              Stroke="#FFFFFF"
                              StrokeThickness="1"
                              Opacity="0.35"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Margin="12"
                              IsHitTestVisible="False"/>
                        <Path Data="M 0 0 L 0 12 L 12 12"
                              Stroke="#FFFFFF"
                              StrokeThickness="1"
                              Opacity="0.35"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Bottom"
                              Margin="12"
                              IsHitTestVisible="False"/>
                        <Path Data="M 0 12 L 12 12 L 12 0"
                              Stroke="#FFFFFF"
                              StrokeThickness="1"
                              Opacity="0.35"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Margin="12"
                              IsHitTestVisible="False"/>

                        <!-- Top-Left Stark Red LIVE Block -->
                        <Border Background="{DynamicResource BrushAccentRed}"
                                CornerRadius="0"
                                Padding="10,4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="16,16,0,0"
                                Visibility="{Binding IsVirtualCamActive, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="■ LIVE • VIRTUAL CAMERA"
                                       FontFamily="{StaticResource FontYoyuPixel}"
                                       FontWeight="Normal"
                                       FontSize="10.5"
                                       Foreground="#FFFFFF"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ROW 2: BOTTOM ARCHITECTURAL CONTROL BAR -->
                <Border Grid.Row="2"
                        Background="{DynamicResource BrushCardBg}"
                        BorderBrush="{DynamicResource BrushBorderActive}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Padding="10,8"
                        Margin="0,12,0,0">
                    <DockPanel>
                        <!-- Right Prominent YOYU Solid CTA Block -->
                        <Button DockPanel.Dock="Right"
                                Command="{Binding ToggleVirtualCameraCommand}"
                                Height="36"
                                Padding="18,0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ctaBorder"
                                                        Background="{DynamicResource BrushCtaPrimaryBg}"
                                                        BorderBrush="{DynamicResource BrushBorderActive}"
                                                        BorderThickness="1"
                                                        CornerRadius="0"
                                                        Padding="{TemplateBinding Padding}"
                                                        SnapsToDevicePixels="True">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Rectangle x:Name="ctaLed" Width="8" Height="8" Fill="#00B995" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="ctaText"
                                                                   Text="START VIRTUAL CAMERA"
                                                                   FontFamily="{StaticResource FontYoyuPixel}"
                                                                   FontWeight="Normal"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource BrushCtaPrimaryFg}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsVirtualCamActive}" Value="True">
                                                        <Setter TargetName="ctaBorder" Property="Background" Value="{DynamicResource BrushAccentRed}"/>
                                                        <Setter TargetName="ctaBorder" Property="BorderBrush" Value="{DynamicResource BrushAccentRed}"/>
                                                        <Setter TargetName="ctaLed" Property="Fill" Value="#FFFFFF"/>
                                                        <Setter TargetName="ctaText" Property="Text" Value="STOP VIRTUAL CAMERA"/>
                                                        <Setter TargetName="ctaText" Property="Foreground" Value="#FFFFFF"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ctaBorder" Property="Opacity" Value="0.88"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="ctaBorder" Property="Opacity" Value="0.72"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Left Tools -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton IsChecked="{Binding FilterSettings.MirrorHorizontal}" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="mirrorBorder"
                                                Background="{DynamicResource BrushInputBg}"
                                                BorderBrush="{DynamicResource BrushBorderPassive}"
                                                BorderThickness="1"
                                                CornerRadius="0"
                                                Padding="12,8"
                                                SnapsToDevicePixels="True">
                                            <TextBlock x:Name="mirrorText"
                                                       Text="MIRROR"
                                                       FontFamily="{StaticResource FontYoyuMono}"
                                                       FontSize="10.5"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource BrushInkPrimary}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="mirrorBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderActive}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="mirrorBorder" Property="Background" Value="{DynamicResource BrushCtaPrimaryBg}"/>
                                                <Setter TargetName="mirrorBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderActive}"/>
                                                <Setter TargetName="mirrorText" Property="Foreground" Value="{DynamicResource BrushCtaPrimaryFg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Button Content="ROTATE 90°"
                                    Style="{StaticResource StudioButtonStyle}"
                                    Command="{Binding Rotate90Command}"
                                    FontFamily="{StaticResource FontYoyuMono}"
                                    FontSize="10.5"
                                    Padding="12,8"
                                    Margin="6,0,0,0"/>

                            <Button Content="RESET ALL"
                                    Style="{StaticResource StudioButtonStyle}"
                                    Command="{Binding ResetAllFiltersCommand}"
                                    FontFamily="{StaticResource FontYoyuMono}"
                                    FontSize="10.5"
                                    Padding="12,8"
                                    Margin="6,0,0,0"/>

                            <Button Content="SNAPSHOT"
                                    Style="{StaticResource StudioButtonStyle}"
                                    Command="{Binding TakeSnapshotCommand}"
                                    FontFamily="{StaticResource FontYoyuMono}"
                                    FontSize="10.5"
                                    Padding="12,8"
                                    Margin="6,0,0,0"/>

                            <Button Content="{Binding RecordButtonText}"
                                    Command="{Binding ToggleRecordVideoCommand}"
                                    FontFamily="{StaticResource FontYoyuMono}"
                                    FontSize="10.5"
                                    FontWeight="Bold"
                                    Padding="12,8"
                                    Margin="6,0,0,0"
                                    Cursor="Hand"
                                    ToolTip="Record Processed Studio Video (.avi)">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BrushInkPrimary}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderPassive}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="recBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="0"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="recBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderActive}"/>
                                                            <Setter TargetName="recBorder" Property="Opacity" Value="0.9"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="recBorder" Property="Opacity" Value="0.75"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecordingVideo}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BrushAccentRed}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentRed}"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ================= COL 2: RIGHT ARCHITECTURAL PANEL ================= -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- CARD 1: 04 / FRAMING & TRANSFORM -->
                    <Border Background="{DynamicResource BrushCardBg}"
                            BorderBrush="{DynamicResource BrushBorderPassive}"
                            BorderThickness="1"
                            CornerRadius="0"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="04 / FRAMING &amp; TRANSFORM"
                                           FontFamily="{StaticResource FontYoyuPixel}"
                                           FontSize="10.5"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource BrushInkPrimary}"
                                           VerticalAlignment="Center"/>
                                <Button Content="RESET"
                                        Style="{StaticResource StudioButtonStyle}"
                                        Command="{Binding ResetFramingCommand}"
                                        FontFamily="{StaticResource FontYoyuMono}"
                                        FontSize="9.5"
                                        Padding="8,3"
                                        HorizontalAlignment="Right"/>
                            </DockPanel>

                            <!-- Zoom -->
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="Zoom" FontSize="11" Foreground="{DynamicResource BrushInkSecondary}"/>
                                <TextBlock Text="{Binding FilterSettings.Zoom, Converter={StaticResource FloatDisplay}, ConverterParameter='0.00x'}"
                                           FontFamily="{StaticResource FontYoyuMono}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushAccentCyan}"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider Minimum="1.0" Maximum="4.0" Value="{Binding FilterSettings.Zoom, Mode=TwoWay}" IsMoveToPointEnabled="True" SmallChange="0.05" LargeChange="0.2"/>

                            <!-- Pan X -->
                            <DockPanel Margin="0,4,0,2">
                                <TextBlock Text="Pan X (Horizontal)" FontSize="11" Foreground="{DynamicResource BrushInkSecondary}"/>
                                <TextBlock Text="{Binding FilterSettings.PanX, Converter={StaticResource FloatDisplay}, ConverterParameter='+0.00;-0.00;0.00'}"
                                           FontFamily="{StaticResource FontYoyuMono}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushAccentCyan}"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider Minimum="-1.0" Maximum="1.0" Value="{Binding FilterSettings.PanX, Mode=TwoWay}" IsMoveToPointEnabled="True" SmallChange="0.05" LargeChange="0.2"/>

                            <!-- Pan Y -->
                            <DockPanel Margin="0,4,0,2">
                                <TextBlock Text="Pan Y (Vertical)" FontSize="11" Foreground="{DynamicResource BrushInkSecondary}"/>
                                <TextBlock Text="{Binding FilterSettings.PanY, Converter={StaticResource FloatDisplay}, ConverterParameter='+0.00;-0.00;0.00'}"
                                           FontFamily="{StaticResource FontYoyuMono}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushAccentCyan}"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider Minimum="-1.0" Maximum="1.0" Value="{Binding FilterSettings.PanY, Mode=TwoWay}" IsMoveToPointEnabled="True" SmallChange="0.05" LargeChange="0.2" Margin="0,2,0,0"/>

                            <!-- Auto Face Framing (Center Stage) -->
                            <ToggleButton IsChecked="{Binding FilterSettings.AutoFramingEnabled, Mode=TwoWay}"
                                          Cursor="Hand"
                                          Margin="0,10,0,0"
                                          ToolTip="Automatically pan &amp; zoom to keep subject centered">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="autoFrameBorder"
                                                Background="{DynamicResource BrushInputBg}"
                                                BorderBrush="{DynamicResource BrushBorderPassive}"
                                                BorderThickness="1"
                                                CornerRadius="0"
                                                Padding="10,7"
                                                SnapsToDevicePixels="True">
                                            <DockPanel>
                                                <Rectangle x:Name="autoFrameLed"
                                                           DockPanel.Dock="Left"
                                                           Width="6"
                                                           Height="6"
                                                           Fill="{DynamicResource BrushInkMuted}"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock x:Name="autoFrameText"
                                                           Text="AUTO FACE FRAMING (CENTER STAGE)"
                                                           FontFamily="{StaticResource FontYoyuMono}"
                                                           FontSize="9.5"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource BrushInkPrimary}"
                                                           VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="autoFrameBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderActive}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="autoFrameBorder" Property="Background" Value="{DynamicResource BrushCtaPrimaryBg}"/>
                                                <Setter TargetName="autoFrameBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderActive}"/>
                                                <Setter TargetName="autoFrameLed" Property="Fill" Value="#00B995"/>
                                                <Setter TargetName="autoFrameText" Property="Foreground" Value="{DynamicResource BrushCtaPrimaryFg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: 05 / COLOR PRESETS (LUTS) -->
                    <Border Background="{DynamicResource BrushCardBg}"
                            BorderBrush="{DynamicResource BrushBorderPassive}"
                            BorderThickness="1"
                            CornerRadius="0"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="05 / COLOR PRESETS (LUTS)"
                                       FontFamily="{StaticResource FontYoyuPixel}"
                                       FontSize="10.5"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource BrushInkPrimary}"
                                       Margin="0,0,0,10"/>

                            <UniformGrid Columns="2">
                                <!-- Natural (None) -->
                                <Button Style="{StaticResource StudioButtonStyle}"
                                        Command="{Binding SelectPresetCommand}"
                                        CommandParameter="None"
                                        Margin="2"
                                        Padding="8,7">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Rectangle Width="6" Height="6" Fill="#858890" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="NATURAL" FontFamily="{StaticResource FontYoyuMono}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushInkPrimary}"/>
                                        </StackPanel>
                                        <TextBlock Text="Neutral tone" FontSize="9.5" Foreground="{DynamicResource BrushInkMuted}" Margin="12,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Studio Warm -->
                                <Button Style="{StaticResource StudioButtonStyle}"
                                        Command="{Binding SelectPresetCommand}"
                                        CommandParameter="StudioWarm"
                                        Margin="2"
                                        Padding="8,7">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Rectangle Width="6" Height="6" Fill="#FF9F0A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="STUDIO WARM" FontFamily="{StaticResource FontYoyuMono}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushInkPrimary}"/>
                                        </StackPanel>
                                        <TextBlock Text="Warm ambient" FontSize="9.5" Foreground="{DynamicResource BrushInkMuted}" Margin="12,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Teal & Orange -->
                                <Button Style="{StaticResource StudioButtonStyle}"
                                        Command="{Binding SelectPresetCommand}"
                                        CommandParameter="CinematicTealOrange"
                                        Margin="2"
                                        Padding="8,7">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Rectangle Width="6" Height="6" Fill="#00D8FF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="TEAL &amp; ORANGE" FontFamily="{StaticResource FontYoyuMono}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushInkPrimary}"/>
                                        </StackPanel>
                                        <TextBlock Text="Hollywood grade" FontSize="9.5" Foreground="{DynamicResource BrushInkMuted}" Margin="12,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Cyberpunk Neon -->
                                <Button Style="{StaticResource StudioButtonStyle}"
                                        Command="{Binding SelectPresetCommand}"
                                        CommandParameter="CyberpunkNeon"
                                        Margin="2"
                                        Padding="8,7">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Rectangle Width="6" Height="6" Fill="#C084FC" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="CYBERPUNK" FontFamily="{StaticResource FontYoyuMono}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushInkPrimary}"/>
                                        </StackPanel>
                                        <TextBlock Text="Neon contrast" FontSize="9.5" Foreground="{DynamicResource BrushInkMuted}" Margin="12,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Noir Mono -->
                                <Button Style="{StaticResource StudioButtonStyle}"
                                        Command="{Binding SelectPresetCommand}"
                                        CommandParameter="NoirMono"
                                        Margin="2"
                                        Padding="8,7">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Rectangle Width="6" Height="6" Fill="{DynamicResource BrushInkPrimary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="NOIR MONO" FontFamily="{StaticResource FontYoyuMono}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushInkPrimary}"/>
                                        </StackPanel>
                                        <TextBlock Text="Dramatic B&amp;W" FontSize="9.5" Foreground="{DynamicResource BrushInkMuted}" Margin="12,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Vivid Pop -->
                                <Button Style="{StaticResource StudioButtonStyle}"
                                        Command="{Binding SelectPresetCommand}"
                                        CommandParameter="VividPop"
                                        Margin="2"
                                        Padding="8,7">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Rectangle Width="6" Height="6" Fill="#00B995" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="VIVID POP" FontFamily="{StaticResource FontYoyuMono}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushInkPrimary}"/>
                                        </StackPanel>
                                        <TextBlock Text="High saturation" FontSize="9.5" Foreground="{DynamicResource BrushInkMuted}" Margin="12,2,0,0"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>

                            <!-- Custom .cube 3D LUT Import Row -->
                            <Border Margin="0,8,0,0"
                                    Background="{DynamicResource BrushInputBg}"
                                    BorderBrush="{DynamicResource BrushBorderPassive}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Padding="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="IMPORT .CUBE LUT"
                                            Style="{StaticResource StudioButtonStyle}"
                                            Command="{Binding ImportCubeLutCommand}"
                                            FontFamily="{StaticResource FontYoyuMono}"
                                            FontSize="9.5"
                                            Padding="8,4"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CustomLutDisplayName}"
                                               FontFamily="{StaticResource FontYoyuMono}"
                                               FontSize="10"
                                               Foreground="{DynamicResource BrushInkSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="8,0"/>
                                    <Button Grid.Column="2"
                                            Content="×"
                                            Style="{StaticResource StudioButtonStyle}"
                                            Command="{Binding ClearCustomLutCommand}"
                                            FontFamily="{StaticResource FontYoyuMono}"
                                            FontSize="11"
                                            Padding="7,2"
                                            ToolTip="Clear Custom 3D LUT"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2B: 05B / AI & PORTRAIT FX -->
                    <Border Background="{DynamicResource BrushCardBg}"
                            BorderBrush="{DynamicResource BrushBorderPassive}"
                            BorderThickness="1"
                            CornerRadius="0"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="05B / AI &amp; PORTRAIT FX"
                                       FontFamily="{StaticResource FontYoyuPixel}"
                                       FontSize="10.5"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource BrushInkPrimary}"
                                       Margin="0,0,0,10"/>

                            <!-- Portrait Blur (Bokeh) -->
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="Portrait Blur (Bokeh)" FontSize="11" Foreground="{DynamicResource BrushInkSecondary}"/>
                                <TextBlock Text="{Binding FilterSettings.BackgroundBlur, Converter={StaticResource FloatDisplay}, ConverterParameter='0'}"
                                           FontFamily="{StaticResource FontYoyuMono}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushAccentCyan}"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider Minimum="0" Maximum="100" Value="{Binding FilterSettings.BackgroundBlur, Mode=TwoWay}" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10"/>

                            <!-- Green Screen (Chroma Key) Toggle -->
                            <ToggleButton IsChecked="{Binding FilterSettings.ChromaKeyEnabled, Mode=TwoWay}"
                                          Cursor="Hand"
                                          Margin="0,6,0,8"
                                          ToolTip="Enable real-time green screen background removal">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="chromaBorder"
                                                Background="{DynamicResource BrushInputBg}"
                                                BorderBrush="{DynamicResource BrushBorderPassive}"
                                                BorderThickness="1"
                                                CornerRadius="0"
                                                Padding="10,7"
                                                SnapsToDevicePixels="True">
                                            <DockPanel>
                                                <Rectangle x:Name="chromaLed"
                                                           DockPanel.Dock="Left"
                                                           Width="6"
                                                           Height="6"
                                                           Fill="{DynamicResource BrushInkMuted}"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock x:Name="chromaText"
                                                           Text="GREEN SCREEN (CHROMA KEY)"
                                                           FontFamily="{StaticResource FontYoyuMono}"
                                                           FontSize="9.5"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource BrushInkPrimary}"
                                                           VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="chromaBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderActive}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="chromaBorder" Property="Background" Value="{DynamicResource BrushCtaPrimaryBg}"/>
                                                <Setter TargetName="chromaBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderActive}"/>
                                                <Setter TargetName="chromaLed" Property="Fill" Value="#00B995"/>
                                                <Setter TargetName="chromaText" Property="Foreground" Value="{DynamicResource BrushCtaPrimaryFg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Key Sensitivity -->
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="Key Sensitivity" FontSize="11" Foreground="{DynamicResource BrushInkSecondary}"/>
                                <TextBlock Text="{Binding FilterSettings.ChromaKeyThreshold, Converter={StaticResource FloatDisplay}, ConverterParameter='0'}"
                                           FontFamily="{StaticResource FontYoyuMono}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushAccentCyan}"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider Minimum="0" Maximum="100" Value="{Binding FilterSettings.ChromaKeyThreshold, Mode=TwoWay}" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3: 06 / FINE IMAGE ADJUSTMENTS -->
                    <Border Background="{DynamicResource BrushCardBg}"
                            BorderBrush="{DynamicResource BrushBorderPassive}"
                            BorderThickness="1"
                            CornerRadius="0"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="06 / FINE IMAGE ADJUSTMENTS"
                                           FontFamily="{StaticResource FontYoyuPixel}"
                                           FontSize="10.5"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource BrushInkPrimary}"
                                           VerticalAlignment="Center"/>
                                <Button Content="RESET"
                                        Style="{StaticResource StudioButtonStyle}"
                                        Command="{Binding ResetImageAdjustmentsCommand}"
                                        FontFamily="{StaticResource FontYoyuMono}"
                                        FontSize="9.5"
                                        Padding="8,3"
                                        HorizontalAlignment="Right"/>
                            </DockPanel>

                            <!-- Brightness -->
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="Brightness" FontSize="11" Foreground="{DynamicResource BrushInkSecondary}"/>
                                <TextBlock Text="{Binding FilterSettings.Brightness, Converter={StaticResource FloatDisplay}, ConverterParameter='0'}"
                                           FontFamily="{StaticResource FontYoyuMono}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider Minimum="-100" Maximum="100" Value="{Binding FilterSettings.Brightness, Mode=TwoWay}" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10"/>

                            <!-- Contrast -->
                            <DockPanel Margin="0,4,0,2">
                                <TextBlock Text="Contrast" FontSize="11" Foreground="{DynamicResource BrushInkSecondary}"/>
                                <TextBlock Text="{Binding FilterSettings.Contrast, Converter={StaticResource FloatDisplay}, ConverterParameter='0'}"
                                           FontFamily="{StaticResource FontYoyuMono}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider Minimum="-100" Maximum="100" Value="{Binding FilterSettings.Contrast, Mode=TwoWay}" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10"/>

                            <!-- Saturation -->
                            <DockPanel Margin="0,4,0,2">
                                <TextBlock Text="Saturation" FontSize="11" Foreground="{DynamicResource BrushInkSecondary}"/>
                                <TextBlock Text="{Binding FilterSettings.Saturation, Converter={StaticResource FloatDisplay}, ConverterParameter='0'}"
                                           FontFamily="{StaticResource FontYoyuMono}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider Minimum="-100" Maximum="100" Value="{Binding FilterSettings.Saturation, Mode=TwoWay}" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10"/>

                            <!-- Temperature -->
                            <DockPanel Margin="0,4,0,2">
                                <TextBlock Text="Temperature" FontSize="11" Foreground="{DynamicResource BrushInkSecondary}"/>
                                <TextBlock Text="{Binding FilterSettings.Temperature, Converter={StaticResource FloatDisplay}, ConverterParameter='0'}"
                                           FontFamily="{StaticResource FontYoyuMono}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider Minimum="-100" Maximum="100" Value="{Binding FilterSettings.Temperature, Mode=TwoWay}" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10"/>

                            <!-- Tint -->
                            <DockPanel Margin="0,4,0,2">
                                <TextBlock Text="Tint" FontSize="11" Foreground="{DynamicResource BrushInkSecondary}"/>
                                <TextBlock Text="{Binding FilterSettings.Tint, Converter={StaticResource FloatDisplay}, ConverterParameter='0'}"
                                           FontFamily="{StaticResource FontYoyuMono}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider Minimum="-100" Maximum="100" Value="{Binding FilterSettings.Tint, Mode=TwoWay}" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10"/>

                            <!-- Sharpness -->
                            <DockPanel Margin="0,4,0,2">
                                <TextBlock Text="Sharpness" FontSize="11" Foreground="{DynamicResource BrushInkSecondary}"/>
                                <TextBlock Text="{Binding FilterSettings.Sharpness, Converter={StaticResource FloatDisplay}, ConverterParameter='0'}"
                                           FontFamily="{StaticResource FontYoyuMono}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider Minimum="0" Maximum="100" Value="{Binding FilterSettings.Sharpness, Mode=TwoWay}" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10"/>

                            <!-- Vignette -->
                            <DockPanel Margin="0,4,0,2">
                                <TextBlock Text="Vignette" FontSize="11" Foreground="{DynamicResource BrushInkSecondary}"/>
                                <TextBlock Text="{Binding FilterSettings.Vignette, Converter={StaticResource FloatDisplay}, ConverterParameter='0'}"
                                           FontFamily="{StaticResource FontYoyuMono}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider Minimum="0" Maximum="100" Value="{Binding FilterSettings.Vignette, Mode=TwoWay}" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- CARD 4: 07 / VIRTUAL CAMERA OUTPUT -->
                    <Border Background="{DynamicResource BrushCardBg}"
                            BorderBrush="{DynamicResource BrushBorderPassive}"
                            BorderThickness="1"
                            CornerRadius="0"
                            Padding="14"
                            Margin="0">
                        <StackPanel>
                            <TextBlock Text="07 / VIRTUAL CAMERA OUTPUT"
                                       FontFamily="{StaticResource FontYoyuPixel}"
                                       FontSize="10.5"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource BrushInkPrimary}"
                                       Margin="0,0,0,10"/>

                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Driver Status" FontSize="10.5" Foreground="{DynamicResource BrushInkSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding VirtualCamStatusText}"
                                           FontFamily="{StaticResource FontYoyuMono}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushAccentGreen}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="Target Device Path:"
                                       FontSize="10"
                                       Foreground="{DynamicResource BrushInkMuted}"
                                       Margin="0,4,0,4"/>
                            <Border Background="{DynamicResource BrushInputBg}"
                                    BorderBrush="{DynamicResource BrushBorderPassive}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Padding="8,5"
                                    Margin="0,0,0,8">
                                <TextBlock Text="{Binding VirtualCamDevicePath}"
                                           FontSize="9.5"
                                           FontFamily="{StaticResource FontYoyuMono}"
                                           Foreground="{DynamicResource BrushInkSecondary}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Active Output Format:" FontSize="10" Foreground="{DynamicResource BrushInkSecondary}"/>
                                <TextBlock Text="{Binding TelemetryResolution}"
                                           FontFamily="{StaticResource FontYoyuMono}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushInkPrimary}"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>

                            <Button Command="{Binding ToggleVirtualCameraCommand}" Padding="14,9">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource YoyuPrimaryButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVirtualCamActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BrushAccentRed}"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentRed}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontFamily="{StaticResource FontYoyuPixel}" FontWeight="Normal" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="INJECT VIRTUAL CAMERA"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVirtualCamActive}" Value="True">
                                                    <Setter Property="Text" Value="DISCONNECT VIRTUAL CAMERA"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
